# Copy to server/.env and fill in. The server boots without these but DB-backed
# routes (auth, tasks) require MONGODB_URI.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=dev-only-change-me

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=4000

# Origin allowed by CORS (the Vite client dev server)
CLIENT_ORIGIN=http://localhost:5173
