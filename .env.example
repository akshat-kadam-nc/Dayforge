# Copy to server/.env and fill in. The server boots without these but DB-backed
# routes (auth, tasks) require MONGODB_URI.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=dev-only-change-me

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Port the API listens on (Render injects its own PORT in production)
PORT=4000

# development | production. In production the API also serves the built client.
NODE_ENV=development

# Single-origin: serve client/dist from the API with an SPA fallback. Auto-on
# when NODE_ENV=production; force with true/false. Leave unset for dev.
# SERVE_CLIENT=true

# Origin allowed by CORS. Dev: the Vite client. Prod: your deployed URL,
# e.g. https://dayforge.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# Google Calendar sync (read-only). Optional — calendar features stay off until
# these are set. Create an OAuth client (Web application) in Google Cloud Console,
# enable the Google Calendar API, and add the redirect URI below as an authorized
# redirect URI. Keep these secret; server/.env is gitignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev value below. In production set this to your deployed callback and add the
# same URL as an authorized redirect URI in Google Cloud Console, e.g.
# https://dayforge.onrender.com/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
