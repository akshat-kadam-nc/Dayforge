{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Emit .d.ts so the Vercel serverless wrapper (api/) can import the compiled
    // app from server/dist with full types.
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // @types/node hoists to the workspace-root node_modules; list both so tsc
    // resolves it under Render's Linux workspace layout, not just locally.
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"]
  },
  "include": ["src"]
}
